{
  "name": "toolip",
  "version": "2.2.1",
  "description": "A TypeScript-powered developer security companion CLI for supply chain security, dependency intelligence, secret detection, security auditing, encrypted local secrets management, Git security checks, and secure development education.",
  "type": "module",
  "bin": {
    "toolip": "dist/src/index.js"
  },
  "main": "dist/src/index.js",
  "files": [
    "dist/src",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": "^22.23.4 || >=24.22.1 <25"
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "dev": "tsx src/index.ts",
    "build": "tsc",
    "start": "node dist/src/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage --exclude tests/core/watch.test.ts",
    "typecheck": "tsc --noEmit",
    "quality": "tsc -p tsconfig.quality.json --noEmit",
    "audit:runtime": "npm audit --omit=dev --audit-level=low",
    "verify:package": "node scripts/verify-package.mjs",
    "verify": "npm run verify:changelog && npm run lint && npm run format:check && npm run verify:workflows && npm run verify:lockfile && npm run audit:all && npm run verify:platform",
    "prepack": "npm run verify",
    "pack:check": "npm pack --dry-run",
    "release:check": "bash scripts/release-check.sh",
    "verify:changelog": "node scripts/verify-changelog.mjs",
    "lint": "biome lint --error-on-warnings .",
    "format:check": "prettier --check . \"!src/**\" \"!tests/**\"",
    "format:changed": "node scripts/check-changed.mjs",
    "audit:all": "npm audit --audit-level=low",
    "audit:signatures": "npm audit signatures",
    "verify:lockfile": "node scripts/verify-lockfile.mjs",
    "verify:workflows": "node scripts/verify-workflows.mjs",
    "verify:platform": "npm run typecheck && npm run quality && npm test && npm run test:coverage && npm run clean && npm run build && npm run verify:package"
  },
  "keywords": [
    "typescript",
    "nodejs",
    "cli",
    "security",
    "security-tool",
    "supply-chain-security",
    "dependency-scanner",
    "vulnerability-scanner",
    "secret-scanner",
    "secrets-management",
    "devsecops",
    "developer-tools",
    "static-analysis",
    "git-security",
    "npm",
    "platform-engineering",
    "dx",
    "cybersecurity"
  ],
  "author": "Ashibuogwu Williams (wbizmo)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wbizmo/toolip.git"
  },
  "bugs": {
    "url": "https://github.com/wbizmo/toolip/issues"
  },
  "homepage": "https://www.zivoralabs.xyz/open-source/toolip/",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "chalk": "^5.4.1",
    "commander": "^13.1.0",
    "fast-glob": "^3.3.3",
    "ignore": "^7.0.3",
    "ora": "^8.2.0",
    "pacote": "^22.0.1",
    "proper-lockfile": "4.1.2",
    "semver": "^7.7.3",
    "typescript": "^5.8.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.5",
    "@types/node": "^22.13.10",
    "@types/proper-lockfile": "4.1.4",
    "@types/semver": "^7.7.1",
    "@vitest/coverage-v8": "^5.1.0",
    "prettier": "3.9.10",
    "tsx": "^4.19.3",
    "vitest": "^5.1.0",
    "yaml": "2.9.1"
  },
  "overrides": {
    "glob": "^14.0.3",
    "minimatch": "^11.0.4"
  }
}
